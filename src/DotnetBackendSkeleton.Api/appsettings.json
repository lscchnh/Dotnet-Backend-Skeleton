{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Name": "Dotnet Backend Skeleton",
    "Description": "Backend skeleton API"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
